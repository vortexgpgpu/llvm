; NOTE: Assertions have been autogenerated by utils/update_test_checks.py
; RUN: opt -mtriple=riscv32 -mattr=+xvortex -passes=infer-address-spaces -S < %s \
; RUN:   | FileCheck %s --check-prefix=VORTEX
; RUN: opt -mtriple=riscv32 -passes=infer-address-spaces -S < %s \
; RUN:   | FileCheck %s --check-prefix=NOVORTEX

; With XVortex, address space 0 is the flat space: the __local_mem() pattern
; (an integer cast to an addrspace(3) pointer, then to generic) gives local
; accesses, and generic pointers loaded from a kernel's read-only argument
; block are global.

declare i32 @lmem_addr()

define float @local_mem(i32 %i) {
; VORTEX-LABEL: @local_mem(
; VORTEX-NEXT:    [[V:%.*]] = call i32 @lmem_addr()
; VORTEX-NEXT:    [[P3:%.*]] = inttoptr i32 [[V]] to ptr addrspace(3)
; VORTEX-NEXT:    [[G:%.*]] = getelementptr inbounds float, ptr addrspace(3) [[P3]], i32 [[I:%.*]]
; VORTEX-NEXT:    [[X:%.*]] = load float, ptr addrspace(3) [[G]], align 4
; VORTEX-NEXT:    [[G1:%.*]] = getelementptr inbounds float, ptr addrspace(3) [[G]], i32 64
; VORTEX-NEXT:    store float [[X]], ptr addrspace(3) [[G1]], align 4
; VORTEX-NEXT:    ret float [[X]]
;
; NOVORTEX-LABEL: @local_mem(
; NOVORTEX-NEXT:    [[V:%.*]] = call i32 @lmem_addr()
; NOVORTEX-NEXT:    [[P3:%.*]] = inttoptr i32 [[V]] to ptr addrspace(3)
; NOVORTEX-NEXT:    [[P:%.*]] = addrspacecast ptr addrspace(3) [[P3]] to ptr
; NOVORTEX-NEXT:    [[G:%.*]] = getelementptr inbounds float, ptr [[P]], i32 [[I:%.*]]
; NOVORTEX-NEXT:    [[X:%.*]] = load float, ptr [[G]], align 4
; NOVORTEX-NEXT:    [[G1:%.*]] = getelementptr inbounds float, ptr [[G]], i32 64
; NOVORTEX-NEXT:    store float [[X]], ptr [[G1]], align 4
; NOVORTEX-NEXT:    ret float [[X]]
;
  %v = call i32 @lmem_addr()
  %p3 = inttoptr i32 %v to ptr addrspace(3)
  %p = addrspacecast ptr addrspace(3) %p3 to ptr
  %g = getelementptr inbounds float, ptr %p, i32 %i
  %x = load float, ptr %g, align 4
  %g1 = getelementptr inbounds float, ptr %g, i32 64
  store float %x, ptr %g1, align 4
  ret float %x
}

%args = type { ptr, ptr, i32 }

define void @kernel(ptr readonly %arg) "vortex-kernel" {
; VORTEX-LABEL: @kernel(
; VORTEX-NEXT:    [[A_ADDR:%.*]] = getelementptr inbounds [[ARGS:%.*]], ptr [[ARG:%.*]], i32 0, i32 0
; VORTEX-NEXT:    [[A:%.*]] = load ptr, ptr [[A_ADDR]], align 4
; VORTEX-NEXT:    [[TMP1:%.*]] = addrspacecast ptr [[A]] to ptr addrspace(1)
; VORTEX-NEXT:    [[B_ADDR:%.*]] = getelementptr inbounds [[ARGS]], ptr [[ARG]], i32 0, i32 1
; VORTEX-NEXT:    [[B:%.*]] = load ptr, ptr [[B_ADDR]], align 4
; VORTEX-NEXT:    [[TMP2:%.*]] = addrspacecast ptr [[B]] to ptr addrspace(1)
; VORTEX-NEXT:    [[X:%.*]] = load float, ptr addrspace(1) [[TMP1]], align 4
; VORTEX-NEXT:    store float [[X]], ptr addrspace(1) [[TMP2]], align 4
; VORTEX-NEXT:    ret void
;
; NOVORTEX-LABEL: @kernel(
; NOVORTEX-NEXT:    [[A_ADDR:%.*]] = getelementptr inbounds [[ARGS:%.*]], ptr [[ARG:%.*]], i32 0, i32 0
; NOVORTEX-NEXT:    [[A:%.*]] = load ptr, ptr [[A_ADDR]], align 4
; NOVORTEX-NEXT:    [[B_ADDR:%.*]] = getelementptr inbounds [[ARGS]], ptr [[ARG]], i32 0, i32 1
; NOVORTEX-NEXT:    [[B:%.*]] = load ptr, ptr [[B_ADDR]], align 4
; NOVORTEX-NEXT:    [[X:%.*]] = load float, ptr [[A]], align 4
; NOVORTEX-NEXT:    store float [[X]], ptr [[B]], align 4
; NOVORTEX-NEXT:    ret void
;
  %a.addr = getelementptr inbounds %args, ptr %arg, i32 0, i32 0
  %a = load ptr, ptr %a.addr, align 4
  %b.addr = getelementptr inbounds %args, ptr %arg, i32 0, i32 1
  %b = load ptr, ptr %b.addr, align 4
  %x = load float, ptr %a, align 4
  store float %x, ptr %b, align 4
  ret void
}

; Not a kernel entry: nothing is known about %arg.
define void @not_kernel(ptr readonly %arg) {
; VORTEX-LABEL: @not_kernel(
; VORTEX-NEXT:    [[A:%.*]] = load ptr, ptr [[ARG:%.*]], align 4
; VORTEX-NEXT:    [[X:%.*]] = load float, ptr [[A]], align 4
; VORTEX-NEXT:    store float [[X]], ptr [[A]], align 4
; VORTEX-NEXT:    ret void
;
; NOVORTEX-LABEL: @not_kernel(
; NOVORTEX-NEXT:    [[A:%.*]] = load ptr, ptr [[ARG:%.*]], align 4
; NOVORTEX-NEXT:    [[X:%.*]] = load float, ptr [[A]], align 4
; NOVORTEX-NEXT:    store float [[X]], ptr [[A]], align 4
; NOVORTEX-NEXT:    ret void
;
  %a = load ptr, ptr %arg, align 4
  %x = load float, ptr %a, align 4
  store float %x, ptr %a, align 4
  ret void
}

; The kernel may write its argument block: no assumption.
define void @kernel_writes_args(ptr %arg, ptr %q) "vortex-kernel" {
; VORTEX-LABEL: @kernel_writes_args(
; VORTEX-NEXT:    store ptr [[Q:%.*]], ptr [[ARG:%.*]], align 4
; VORTEX-NEXT:    [[A:%.*]] = load ptr, ptr [[ARG]], align 4
; VORTEX-NEXT:    [[X:%.*]] = load float, ptr [[A]], align 4
; VORTEX-NEXT:    store float [[X]], ptr [[Q]], align 4
; VORTEX-NEXT:    ret void
;
; NOVORTEX-LABEL: @kernel_writes_args(
; NOVORTEX-NEXT:    store ptr [[Q:%.*]], ptr [[ARG:%.*]], align 4
; NOVORTEX-NEXT:    [[A:%.*]] = load ptr, ptr [[ARG]], align 4
; NOVORTEX-NEXT:    [[X:%.*]] = load float, ptr [[A]], align 4
; NOVORTEX-NEXT:    store float [[X]], ptr [[Q]], align 4
; NOVORTEX-NEXT:    ret void
;
  store ptr %q, ptr %arg, align 4
  %a = load ptr, ptr %arg, align 4
  %x = load float, ptr %a, align 4
  store float %x, ptr %q, align 4
  ret void
}
