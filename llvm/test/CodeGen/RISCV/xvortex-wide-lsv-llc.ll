  %acc = phi float [ 0.0, %entry ], [ %s, %loop ]
  %v = load <4 x float>, ptr addrspace(3) %q, align 16
  %a = extractelement <4 x float> %v, i32 0
  %b = extractelement <4 x float> %v, i32 3
