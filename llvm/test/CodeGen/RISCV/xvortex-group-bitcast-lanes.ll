define i32 @f2i_computed_two_lanes(ptr %p, ptr %q) {
; RV32-LABEL: f2i_computed_two_lanes:
; RV32:       # %bb.0:
; RV32-NEXT:    vx_flw.q fa2, 0(a0)
; RV32-NEXT:    vx_flw.q ft8, 0(a1)
; RV32-NEXT:    fadd.s fa4, fa4, ft10
; RV32-NEXT:    fadd.s fa3, fa3, ft9
