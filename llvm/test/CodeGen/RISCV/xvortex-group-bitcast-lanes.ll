; A bitcast between an XVortex GPR group and an FPR group moves only the
; lanes its users read; when every user extracts a constant lane, a lane
; nobody reads is neither moved nor, for a loaded source, loaded. A bitcast
; with any other user moves every lane.

define float @i2f_one_lane(i32 %a, i32 %b, i32 %c, i32 %d) {
; RV32-LABEL: i2f_one_lane:
; RV32:       # %bb.0:
; RV32-NEXT:    fmv.w.x fa0, a2
; RV32-NEXT:    ret
  %v0 = insertelement <4 x i32> poison, i32 %a, i32 0
  %v1 = insertelement <4 x i32> %v0, i32 %b, i32 1
  %v2 = insertelement <4 x i32> %v1, i32 %c, i32 2
  %v3 = insertelement <4 x i32> %v2, i32 %d, i32 3
  %f = bitcast <4 x i32> %v3 to <4 x float>
  %e = extractelement <4 x float> %f, i32 2
  ret float %e
}

define i32 @f2i_loaded_one_lane(ptr %p) {
; RV32-LABEL: f2i_loaded_one_lane:
; RV32:       # %bb.0:
; RV32-NEXT:    lw a0, 4(a0)
; RV32-NEXT:    ret
  %v = load <4 x float>, ptr %p
  %i = bitcast <4 x float> %v to <4 x i32>
  %e = extractelement <4 x i32> %i, i32 1
  ret i32 %e
}

define i32 @f2i_loaded_two_lanes(ptr %p) {
