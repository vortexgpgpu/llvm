; Local stack slot allocation shares one virtual base register among frame
; objects beyond the immediate range. A wide access may use the shared base
; only when its offset from it is a multiple of 8 (.d) or 16 (.q): %a sits
; 36 bytes above %c, so it needs a base of its own.

declare void @use(ptr, ptr, ptr, ptr)

define void @far_objects(<4 x float> %v, <4 x float> %w, <2 x float> %x) {
; CHECK-LABEL: far_objects:
; CHECK:       # %bb.0:
; CHECK-NEXT:    addi sp, sp, -2032
; CHECK-NEXT:    .cfi_def_cfa_offset 2032
; CHECK-NEXT:    sw ra, 2028(sp) # 4-byte Folded Spill
; CHECK-NEXT:    .cfi_offset ra, -4
; CHECK-NEXT:    addi sp, sp, -2048
; CHECK-NEXT:    addi sp, sp, -80
; CHECK-NEXT:    .cfi_def_cfa_offset 4160
; CHECK-NEXT:    fmv.s ft11, fa7
; CHECK-NEXT:    fmv.s ft3, fa3
; CHECK-NEXT:    lui a2, 1
; CHECK-NEXT:    addi a2, a2, 12
; CHECK-NEXT:    add a2, sp, a2
; CHECK-NEXT:    fmv.s ft10, fa6
; CHECK-NEXT:    fmv.s ft2, fa2
; CHECK-NEXT:    fmv.w.x fa3, a1
; CHECK-NEXT:    lui a1, 1
; CHECK-NEXT:    addi a1, a1, 32
; CHECK-NEXT:    add a1, sp, a1
; CHECK-NEXT:    fmv.s ft1, fa1
; CHECK-NEXT:    fmv.w.x fa2, a0
; CHECK-NEXT:    fmv.s ft9, fa5
; CHECK-NEXT:    fmv.s ft0, fa0
; CHECK-NEXT:    lui a0, 1
; CHECK-NEXT:    add a0, sp, a0
; CHECK-NEXT:    vx_fsw.q ft0, 48(a0)
; CHECK-NEXT:    fmv.s ft8, fa4
; CHECK-NEXT:    vx_fsw.q ft8, 16(a2)
; CHECK-NEXT:    vx_fsw.q ft0, 0(a2)
; CHECK-NEXT:    vx_fsw.d fa2, 0(a1)
; CHECK-NEXT:    addi a0, sp, 12
; CHECK-NEXT:    lui a1, 1
; CHECK-NEXT:    addi a1, a1, 48
; CHECK-NEXT:    add a1, sp, a1
; CHECK-NEXT:    lui a2, 1
; CHECK-NEXT:    addi a2, a2, 28
; CHECK-NEXT:    add a2, sp, a2
; CHECK-NEXT:    lui a3, 1
; CHECK-NEXT:    addi a3, a3, 12
; CHECK-NEXT:    add a3, sp, a3
; CHECK-NEXT:    call use
; CHECK-NEXT:    addi sp, sp, 2032
; CHECK-NEXT:    addi sp, sp, 96
; CHECK-NEXT:    .cfi_def_cfa_offset 2032
; CHECK-NEXT:    lw ra, 2028(sp) # 4-byte Folded Reload
; CHECK-NEXT:    .cfi_restore ra
; CHECK-NEXT:    addi sp, sp, 2032
; CHECK-NEXT:    .cfi_def_cfa_offset 0
; CHECK-NEXT:    ret
  %a = alloca [3 x float], align 4
  %b = alloca [5 x float], align 4
  %c = alloca [4 x float], align 4
  %big = alloca [1024 x float], align 4
  store <4 x float> %v, ptr %a, align 4
  store <4 x float> %w, ptr %b, align 4
  store <4 x float> %v, ptr %c, align 4
  %b4 = getelementptr inbounds i8, ptr %b, i32 4
  store <2 x float> %x, ptr %b4, align 4
  call void @use(ptr %big, ptr %a, ptr %b, ptr %c)
  ret void
}
